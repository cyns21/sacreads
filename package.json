{
  "name": "sacreads",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "scrape:spl": "node scripts/scrape-spl-books.mjs",
    "scrape:spl:browser": "node scripts/scrape-spl-playwright.mjs",
    "import:spl:csv": "node scripts/import-spl-csv.mjs --balanced",
    "import:spl:csv:reset": "node scripts/import-spl-csv.mjs --reset --balanced",
    "import:spl:csv:balanced": "node scripts/import-spl-csv.mjs --reset --balanced --max-rows-per-file=150 --max-books=5000",
    "import:spl:csv:balanced:larger": "node scripts/import-spl-csv.mjs --reset --balanced --max-rows-per-file=250 --file-book-limit=100 --max-books=6000",
    "import:spl:csv:dry": "node scripts/import-spl-csv.mjs --dry-run --balanced --max-files=3",
    "import:goodreads": "node scripts/import-goodreads-metadata.mjs",
    "export:goodreads:missing": "node scripts/export-goodreads-missing.mjs",
    "report:books": "node scripts/report-missing-book-metadata.mjs",
    "books:missing": "node scripts/report-missing-book-metadata.mjs"
  },
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.7.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.60.0",
    "postcss": "8.5.14",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3"
  }
}
